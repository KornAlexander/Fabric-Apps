# Governance Hub — committed configuration template.
#
# Copy to `.env` and fill in your ids. `.env` is gitignored because a real
# deployment puts tenant-specific ids in it; this file is the shape.
#
# Every value here is an id, not a credential. Service-principal secrets live in
# your Key Vault and are only ever read inside a notebook actuator — never in
# the SPA bundle, which Fabric static hosting serves anonymously.

# ── Identity ────────────────────────────────────────────────────────────────
# Also emitted by `rayfin env` into .env.local, which takes precedence.
VITE_FABRIC_TENANT_ID=
VITE_FABRIC_SPA_CLIENT_ID=

# ── Server-side REST hop ────────────────────────────────────────────────────
# The shared `fabric_proxy` User Data Function invoke URL. Without it the app
# still runs, at T0, and the Setup page says exactly what is missing.
VITE_UDF_FABRIC_PROXY_URL=

# ── Governance storage ──────────────────────────────────────────────────────
# Workspace hosting governance_lh, the Governance Model and the notebooks.
VITE_GOV_WORKSPACE_ID=
# Direct Lake semantic model id — populated after the bootstrap creates it.
VITE_GOV_MODEL_ID=

# ── Notebooks ───────────────────────────────────────────────────────────────
VITE_GOV_BOOTSTRAP_NOTEBOOK_ID=
VITE_GOV_FABRIC_COLLECTOR_NOTEBOOK_ID=
VITE_GOV_PP_COLLECTOR_NOTEBOOK_ID=
VITE_GOV_AGENT_COLLECTOR_NOTEBOOK_ID=
VITE_GOV_ENTRA_COLLECTOR_NOTEBOOK_ID=

# The single write path. Every privileged change goes through this notebook,
# which re-evaluates all four write gates server-side. Leave it empty and the
# app cannot write anything at all — the safe default for a read-only pilot.
VITE_GOV_ACTUATOR_NOTEBOOK_ID=

# ── Build-time module kill switches ─────────────────────────────────────────
# Set to `false` to compile a module out entirely — for customers who must
# prove a control plane is absent, not merely disabled.
VITE_MODULE_FABRIC=true
VITE_MODULE_PP=true
VITE_MODULE_AGENT=true
VITE_MODULE_ENTRA=true
