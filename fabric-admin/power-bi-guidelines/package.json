{
  "name": "power-bi-guidelines",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "template": {
    "name": "power-bi-guidelines",
    "displayName": "Power BI Guidelines",
    "description": "Power BI guidelines and best practices for data integration, modeling and visualization, tailored to a team's own conventions in the browser, plus a plain HTML version.",
    "category": "fabric-tools"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node tools/build-html.mjs",
    "build:fabric": "tsc -b && vite build && node tools/build-html.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "build:html": "node tools/build-html.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.36.2",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
