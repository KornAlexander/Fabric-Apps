node_modules/
dist/
*.tsbuildinfo

# Secrets and tenant coordinates. Never commit.
.env
.env.local
rayfin/.deployments.json

# Generated art and audio. Reproducible from tools/art and tools/audio.
app/public/assets/art/**/*.png
app/public/assets/art/**/*.webp
app/public/assets/audio/**/*.mp3
app/public/assets/audio/**/*.ogg

# The anthem, and the trailer that carries it.
#
# ⚠️ Kept out on LICENCE grounds, not size. "Familia Nostra" was generated with
# Suno on a free plan, whose output is licensed for non-commercial use, and this
# repository is intended to go public. The opening title sequence is code and
# ships; it simply plays in silence when the file below is absent, which is the
# state of every fresh clone. See NOTICE.
app/public/audio/
# ⚠️ Leading slash: root only. Without it this pattern matches a directory
# called `media` at ANY depth, and it silently swallowed `tools/media/`, the
# recorder that exists so the intro video stops being a hand-made copy. The
# tool written to prevent drift would itself never have been committed, and
# `git status` reports nothing at all when a file is ignored.
# Guarded by app/test/repoVisibility.test.ts.
/media/

# Question authoring sources ARE committed: see learn/content/dp-600/questions/src.
# The answer obfuscation protects the shipped bundle, which is what a player
# would inspect. It cannot protect a public repo, and pretending otherwise
# would cost the ability to maintain the bank for no real gain.

# Generated question banks written by the capacity host.
#
# Not committed, deliberately. These are drafted by a model and reviewed by
# whoever happened to be sitting there, so they are somebody's working notes
# rather than content this project stands behind. The shipped DP-600 bank is
# checked by tests; this is not, and mixing the two in one repository would
# make it impossible to tell them apart later.
tools/coach/banks/

# ⚠️ Carries a `publishableKey`, and the deployment's own identity.
#
# Section 13 also wants it kept LOCALLY rather than deleted: it is what holds
# the hosting URL stable across deploys, and a changed host breaks sign-in with
# AADSTS50011. So: never committed, never thrown away.
rayfin/.deployments.json
rayfin/.env
rayfin/.env.local

# ⚠️ The internal IP and terms assessment. Deliberately not published.
#
# A public repository should state its position, which the README does, not
# publish its own risk analysis. A document that inventories where a project is
# weakest is a map for anyone who wants to press on it, it carries no legal
# privilege, and it goes stale the moment the code moves. It stays local.
IP-ASSESSMENT.md

# The teaser carries the Suno cue, so it is kept out on the same LICENCE
# grounds as the soundtrack. The app probes for it and skips straight to the
# setup screen when it is absent, which is the state of every fresh clone.
app/public/teaser.mp4

# The buried-cache films. Ignored for SIZE, not licence: these came from Azure
# OpenAI, whose output we own, so unlike the teaser they could be committed.
# D59 says a clone stays a few megabytes, and 4.9 MB for one optional flourish
# is not where to break that. `treasureFilm.ts` probes for both and turns the
# beats into no-ops when they are missing; the chest still pays out.
# Masters live in the ignored /media/treasure-scenes/, regenerated by
# tools/treasure-clips.py.
app/public/treasure-found.mp4
app/public/treasure-opened.mp4

# Compiled entity output from ayfin up. Regenerated on every deploy.
rayfin/.temp/

# Coordinates for the workspace these scripts deploy into, and their scratch
# output. See tools/fabric/.env.example for the shape.
tools/fabric/.env
tools/fabric/.out/
__pycache__/
