# Coordinates for the Fabric workspace these scripts deploy into.
#
# Copy to `.env` and fill in. `.env` is gitignored: every value here names a
# real workspace, database, report or machine, and none of it belongs in a
# public repository.
#
# Find them in the Fabric portal URL of each item, or with the REST API.

# The workspace the semantic model and report live in.
FE_WORKSPACE_ID=<workspace-guid>

# Its display name, as it appears in the XMLA connection string.
FE_WORKSPACE_NAME=My Workspace

# The Fabric SQL database item whose mirrored OneLake tables the model reads.
FE_SQLDB_ITEM_ID=<sql-database-item-guid>

# The deployed semantic model. Written by deploy_semantic_model.py on first run.
FE_MODEL_ID=<semantic-model-guid>

# The SQL endpoint of that database, for the two scripts that write tables.
FE_SQL_SERVER=<host>.database.fabric.microsoft.com,1433
FE_SQL_DATABASE=<database-name>

# Only build_report.py needs this: the Hochschul-Insights report the theme and
# background image are copied from.
FE_THEME_SOURCE=C:\path\to\Hochschul-Insights
