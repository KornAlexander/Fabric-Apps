# Airport IQ backend configuration. Copy to .env (gitignored) for local dev.

# --- Server ---
PORT=8080
# Comma-separated allowed CORS origins. "*" is safe locally (no cookies are
# ever sent). In production set this to the exact Fabric app hosting origin
# (https://<app>-<region>.webapp.fabricapps.net).
CORS_ALLOW_ORIGINS=*

# Optional coarse abuse gate: when set, every /api/* call must send a matching
# `x-app-key` header (the frontend bakes in the same value). Browser-extractable,
# so it is a coarse gate, not a per-user credential.
# BACKEND_APP_KEY=

# Default airport for grounded tools when a request omits `airport`. DUS or BER.
AIRPORT_IQ_DEFAULT_AIRPORT=DUS

# --- Azure OpenAI in Foundry (chat + realtime voice) ---
# Required for /api/assistant/* and /api/realtime/*.
AZURE_OPENAI_ENDPOINT=https://aif-airportiq-swc.cognitiveservices.azure.com/
# One auth source: managed identity (Container Apps), Azure CLI (local), token, or key.
AZURE_OPENAI_USE_AZURE_CLI_TOKEN=true
# AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.2
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime
AZURE_OPENAI_REALTIME_VOICE=sage
# gpt-5.x reasoning effort for chat latency (minimal/low/medium/high; empty to disable).
AZURE_OPENAI_REASONING_EFFORT=low
# Output budget (reasoning tokens count against this — keep generous).
AZURE_OPENAI_MAX_OUTPUT_TOKENS=2000
