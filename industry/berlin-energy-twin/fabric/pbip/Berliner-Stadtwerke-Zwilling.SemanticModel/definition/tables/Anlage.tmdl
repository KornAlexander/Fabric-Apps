/// Erzeugungs- und Speichereinheiten der drei Partner aus dem Marktstammdatenregister (MaStR), eine Zeile je MaStR-Nummer. Energieträger Solar, Wind, Erdgas, andere Gase, Speicher, Biomasse. Bruttoleistung in kW (bei Solar kWp). Betriebsstatus beachten: einige BVG-Anlagen sind vorübergehend stillgelegt. Betriebshof nennt den BVG-Standort einer Anlage. Kleine Anlagen haben keine öffentliche Adresse und sind nur nach Postleitzahl verortet. Zwei Anlagen liegen außerhalb Berlins (Bezirk leer). Auch: Erzeugungsanlage, Einheit, PV-Anlage.
table Anlage

	column 'MaStR-Nummer'
		dataType: string
		summarizeBy: none
		sourceColumn: MaStR-Nummer

		annotation SummarizationSetBy = Automatic

	column Anlagenname
		dataType: string
		summarizeBy: none
		sourceColumn: Anlagenname

		annotation SummarizationSetBy = Automatic

	column 'Partner-Schlüssel'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Partner-Schlüssel

		annotation SummarizationSetBy = Automatic

	column Betreiber
		dataType: string
		summarizeBy: none
		sourceColumn: Betreiber

		annotation SummarizationSetBy = Automatic

	column Energieträger
		dataType: string
		summarizeBy: none
		sourceColumn: Energieträger

		annotation SummarizationSetBy = Automatic

	column 'Energieträger MaStR'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Energieträger MaStR

		annotation SummarizationSetBy = Automatic

	column 'Bruttoleistung kW'
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Bruttoleistung kW

		annotation SummarizationSetBy = Automatic

	column 'Nettoleistung kW'
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Nettoleistung kW

		annotation SummarizationSetBy = Automatic

	column 'Speicherkapazität kWh'
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Speicherkapazität kWh

		annotation SummarizationSetBy = Automatic

	column Betriebsstatus
		dataType: string
		summarizeBy: none
		sourceColumn: Betriebsstatus

		annotation SummarizationSetBy = Automatic

	column Inbetriebnahme
		dataType: dateTime
		formatString: dd.mm.yyyy
		summarizeBy: none
		sourceColumn: Inbetriebnahme

		annotation SummarizationSetBy = Automatic

	column Inbetriebnahmejahr
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Inbetriebnahmejahr

		annotation SummarizationSetBy = Automatic

	column PLZ
		dataType: string
		summarizeBy: none
		sourceColumn: PLZ
		dataCategory: PostalCode

		annotation SummarizationSetBy = Automatic

	column Ort
		dataType: string
		summarizeBy: none
		sourceColumn: Ort

		annotation SummarizationSetBy = Automatic

	column Straße
		dataType: string
		summarizeBy: none
		sourceColumn: Straße

		annotation SummarizationSetBy = Automatic

	column Hausnummer
		dataType: string
		summarizeBy: none
		sourceColumn: Hausnummer

		annotation SummarizationSetBy = Automatic

	column Mieterstrom
		dataType: string
		summarizeBy: none
		sourceColumn: Mieterstrom

		annotation SummarizationSetBy = Automatic

	column Anlagenart
		dataType: string
		summarizeBy: none
		sourceColumn: Anlagenart

		annotation SummarizationSetBy = Automatic

	column Einspeiseart
		dataType: string
		summarizeBy: none
		sourceColumn: Einspeiseart

		annotation SummarizationSetBy = Automatic

	column Verortung
		dataType: string
		summarizeBy: none
		sourceColumn: Verortung

		annotation SummarizationSetBy = Automatic

	column 'Genau verortet'
		dataType: string
		summarizeBy: none
		sourceColumn: Genau verortet

		annotation SummarizationSetBy = Automatic

	column Betriebshof
		dataType: string
		summarizeBy: none
		sourceColumn: Betriebshof

		annotation SummarizationSetBy = Automatic

	column Bezirk
		dataType: string
		summarizeBy: none
		sourceColumn: Bezirk

		annotation SummarizationSetBy = Automatic

	column Längengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Längengrad
		dataCategory: Longitude

		annotation SummarizationSetBy = Automatic

	column Breitengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Breitengrad
		dataCategory: Latitude

		annotation SummarizationSetBy = Automatic

	partition Anlage = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=";", Columns=25, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars=true]),
				    Typisiert = Table.TransformColumnTypes(Kopfzeilen, {{"MaStR-Nummer", type text}, {"Anlagenname", type text}, {"Partner-Schlüssel", type text}, {"Betreiber", type text}, {"Energieträger", type text}, {"Energieträger MaStR", type text}, {"Bruttoleistung kW", type number}, {"Nettoleistung kW", type number}, {"Speicherkapazität kWh", type number}, {"Betriebsstatus", type text}, {"Inbetriebnahme", type date}, {"Inbetriebnahmejahr", Int64.Type}, {"PLZ", type text}, {"Ort", type text}, {"Straße", type text}, {"Hausnummer", type text}, {"Mieterstrom", type text}, {"Anlagenart", type text}, {"Einspeiseart", type text}, {"Verortung", type text}, {"Genau verortet", type text}, {"Betriebshof", type text}, {"Bezirk", type text}, {"Längengrad", type number}, {"Breitengrad", type number}}, "en-US")
				in
				    Typisiert

	annotation PBI_ResultType = Table
