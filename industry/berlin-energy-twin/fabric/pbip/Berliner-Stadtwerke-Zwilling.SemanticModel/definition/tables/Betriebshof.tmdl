/// BVG-Standorte (Bus-, Straßenbahn-, U-Bahn-Betriebshöfe und weitere) mit Status, Solarvereinbarung 2025 von BVG und Berliner Stadtwerken und der zugeordneten Photovoltaik-Leistung. Auch: Depot, Betriebsbahnhof.
table Betriebshof

	column 'Betriebshof-ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Betriebshof-ID

		annotation SummarizationSetBy = Automatic

	column Betriebshof
		dataType: string
		summarizeBy: none
		sourceColumn: Betriebshof

		annotation SummarizationSetBy = Automatic

	column Art
		dataType: string
		summarizeBy: none
		sourceColumn: Art

		annotation SummarizationSetBy = Automatic

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: Status

		annotation SummarizationSetBy = Automatic

	column 'Solarvereinbarung 2025'
		dataType: string
		summarizeBy: none
		sourceColumn: Solarvereinbarung 2025

		annotation SummarizationSetBy = Automatic

	column 'Solarleistung kWp'
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Solarleistung kWp

		annotation SummarizationSetBy = Automatic

	column Solaranlagen
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Solaranlagen

		annotation SummarizationSetBy = Automatic

	column Bezirk
		dataType: string
		summarizeBy: none
		sourceColumn: Bezirk

		annotation SummarizationSetBy = Automatic

	column Quelle
		dataType: string
		summarizeBy: none
		sourceColumn: Quelle
		dataCategory: WebUrl

		annotation SummarizationSetBy = Automatic

	column Längengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Längengrad
		dataCategory: Longitude

		annotation SummarizationSetBy = Automatic

	column Breitengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Breitengrad
		dataCategory: Latitude

		annotation SummarizationSetBy = Automatic

	partition Betriebshof = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=";", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars=true]),
				    Typisiert = Table.TransformColumnTypes(Kopfzeilen, {{"Betriebshof-ID", type text}, {"Betriebshof", type text}, {"Art", type text}, {"Status", type text}, {"Solarvereinbarung 2025", type text}, {"Solarleistung kWp", type number}, {"Solaranlagen", Int64.Type}, {"Bezirk", type text}, {"Quelle", type text}, {"Längengrad", type number}, {"Breitengrad", type number}}, "en-US")
				in
				    Typisiert

	annotation PBI_ResultType = Table
