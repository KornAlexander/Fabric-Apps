/// Die zwölf Berliner Bezirke mit Einwohnern (Einwohnerregister 31.12.2025) und allen Ladepunkten laut Land Berlin inklusive privater. Auch: Stadtbezirk.
table Bezirk

	column 'Bezirk-Nr'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Bezirk-Nr

		annotation SummarizationSetBy = Automatic

	column Bezirk
		dataType: string
		summarizeBy: none
		sourceColumn: Bezirk
		sortByColumn: 'Bezirk-Nr'
		dataCategory: County

		annotation SummarizationSetBy = Automatic

	column Einwohner
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Einwohner

		annotation SummarizationSetBy = Automatic

	column 'Ladepunkte Register gesamt'
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Ladepunkte Register gesamt

		annotation SummarizationSetBy = Automatic

	column 'Ladeleistung Register gesamt kW'
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Ladeleistung Register gesamt kW

		annotation SummarizationSetBy = Automatic

	column 'Stand Ladepunkte Register'
		dataType: string
		summarizeBy: none
		sourceColumn: Stand Ladepunkte Register

		annotation SummarizationSetBy = Automatic

	column Längengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Längengrad
		dataCategory: Longitude

		annotation SummarizationSetBy = Automatic

	column Breitengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Breitengrad
		dataCategory: Latitude

		annotation SummarizationSetBy = Automatic

	partition Bezirk = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=";", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars=true]),
				    Typisiert = Table.TransformColumnTypes(Kopfzeilen, {{"Bezirk-Nr", Int64.Type}, {"Bezirk", type text}, {"Einwohner", Int64.Type}, {"Ladepunkte Register gesamt", Int64.Type}, {"Ladeleistung Register gesamt kW", type number}, {"Stand Ladepunkte Register", type text}, {"Längengrad", type number}, {"Breitengrad", type number}}, "en-US")
				in
				    Typisiert

	annotation PBI_ResultType = Table
