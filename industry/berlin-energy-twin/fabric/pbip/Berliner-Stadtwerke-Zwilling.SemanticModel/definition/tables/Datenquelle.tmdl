/// Herkunft, Namensnennung und Lizenz der Daten je Tabelle. Bei Weitergabe die Namensnennung mitgeben.
table Datenquelle

	column Tabellen
		dataType: string
		summarizeBy: none
		sourceColumn: Tabellen

		annotation SummarizationSetBy = Automatic

	column Quelle
		dataType: string
		summarizeBy: none
		sourceColumn: Quelle

		annotation SummarizationSetBy = Automatic

	column Namensnennung
		dataType: string
		summarizeBy: none
		sourceColumn: Namensnennung

		annotation SummarizationSetBy = Automatic

	column Lizenz
		dataType: string
		summarizeBy: none
		sourceColumn: Lizenz

		annotation SummarizationSetBy = Automatic

	column 'Lizenz-URL'
		dataType: string
		summarizeBy: none
		sourceColumn: Lizenz-URL
		dataCategory: WebUrl

		annotation SummarizationSetBy = Automatic

	column Stand
		dataType: string
		summarizeBy: none
		sourceColumn: Stand

		annotation SummarizationSetBy = Automatic

	partition Datenquelle = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=";", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars=true]),
				    Typisiert = Table.TransformColumnTypes(Kopfzeilen, {{"Tabellen", type text}, {"Quelle", type text}, {"Namensnennung", type text}, {"Lizenz", type text}, {"Lizenz-URL", type text}, {"Stand", type text}}, "en-US")
				in
				    Typisiert

	annotation PBI_ResultType = Table
