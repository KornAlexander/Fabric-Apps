/// degewo-Fokusdächer: Gebäude mit Solarkataster-Potenzial, auf denen eine degewo-Anlage verortet ist, mit installierter Leistung und offenem Potenzial. Keine Dächer der Stadtwerke oder der BVG; kein Partnerfilter wirkt hier. Nicht mit der Tabelle Quartier verbunden: je Quartier über die Spalte Quartier gruppieren. Potenzial ist eine Schätzung des Solarkatasters Berlin. Gebäudehöhe aus dem 3D-Gebäudemodell LoD2.
table Fokusdach

	column 'Gebäude-ID'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Gebäude-ID

		annotation SummarizationSetBy = Automatic

	column Adresse
		dataType: string
		summarizeBy: none
		sourceColumn: Adresse
		dataCategory: Address

		annotation SummarizationSetBy = Automatic

	column Gebäudefunktion
		dataType: string
		summarizeBy: none
		sourceColumn: Gebäudefunktion

		annotation SummarizationSetBy = Automatic

	column 'Dachfläche m²'
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Dachfläche m²

		annotation SummarizationSetBy = Automatic

	column 'Solarpotenzial kWp'
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Solarpotenzial kWp

		annotation SummarizationSetBy = Automatic

	column 'Installiert kWp'
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Installiert kWp

		annotation SummarizationSetBy = Automatic

	column 'Offenes Potenzial kWp'
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: Offenes Potenzial kWp

		annotation SummarizationSetBy = Automatic

	column Ausschöpfung
		dataType: double
		formatString: 0.0 %
		summarizeBy: none
		sourceColumn: Ausschöpfung

		annotation SummarizationSetBy = Automatic

	column 'Anlagen auf dem Dach'
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Anlagen auf dem Dach

		annotation SummarizationSetBy = Automatic

	column 'Quartier-ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Quartier-ID

		annotation SummarizationSetBy = Automatic

	column Quartier
		dataType: string
		summarizeBy: none
		sourceColumn: Quartier

		annotation SummarizationSetBy = Automatic

	column Bezirk
		dataType: string
		summarizeBy: none
		sourceColumn: Bezirk

		annotation SummarizationSetBy = Automatic

	column 'Gebäudehöhe m'
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: Gebäudehöhe m

		annotation SummarizationSetBy = Automatic

	column 'Geländehöhe m'
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: Geländehöhe m

		annotation SummarizationSetBy = Automatic

	column Längengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Längengrad
		dataCategory: Longitude

		annotation SummarizationSetBy = Automatic

	column Breitengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Breitengrad
		dataCategory: Latitude

		annotation SummarizationSetBy = Automatic

	partition Fokusdach = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=";", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars=true]),
				    Typisiert = Table.TransformColumnTypes(Kopfzeilen, {{"Gebäude-ID", Int64.Type}, {"Adresse", type text}, {"Gebäudefunktion", type text}, {"Dachfläche m²", type number}, {"Solarpotenzial kWp", type number}, {"Installiert kWp", type number}, {"Offenes Potenzial kWp", type number}, {"Ausschöpfung", type number}, {"Anlagen auf dem Dach", Int64.Type}, {"Quartier-ID", type text}, {"Quartier", type text}, {"Bezirk", type text}, {"Gebäudehöhe m", type number}, {"Geländehöhe m", type number}, {"Längengrad", type number}, {"Breitengrad", type number}}, "en-US")
				in
				    Typisiert

	annotation PBI_ResultType = Table
