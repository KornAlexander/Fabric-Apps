/// Öffentliche Ladestationen aus dem Ladesäulenregister Berlin (Geoportal, Stand des Abrufs), ohne Live-Status. Höchstleistung ist die größte Leistung eines Ladepunkts der Station. Stadtwerke = ja für Stationen der Berliner Stadtwerke. Auch: Ladesäule, Ladeinfrastruktur.
table Ladestation

	column 'Ladestation-ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Ladestation-ID

		annotation SummarizationSetBy = Automatic

	column Betreiber
		dataType: string
		summarizeBy: none
		sourceColumn: Betreiber

		annotation SummarizationSetBy = Automatic

	column Stadtwerke
		dataType: string
		summarizeBy: none
		sourceColumn: Stadtwerke

		annotation SummarizationSetBy = Automatic

	column Adresse
		dataType: string
		summarizeBy: none
		sourceColumn: Adresse
		dataCategory: Address

		annotation SummarizationSetBy = Automatic

	column PLZ
		dataType: string
		summarizeBy: none
		sourceColumn: PLZ
		dataCategory: PostalCode

		annotation SummarizationSetBy = Automatic

	column Bezirk
		dataType: string
		summarizeBy: none
		sourceColumn: Bezirk

		annotation SummarizationSetBy = Automatic

	column Ladepunkte
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Ladepunkte

		annotation SummarizationSetBy = Automatic

	column 'Höchstleistung kW'
		dataType: double
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: Höchstleistung kW

		annotation SummarizationSetBy = Automatic

	column Leistungsklasse
		dataType: string
		summarizeBy: none
		sourceColumn: Leistungsklasse

		annotation SummarizationSetBy = Automatic

	column 'Schnellladen DC'
		dataType: string
		summarizeBy: none
		sourceColumn: Schnellladen DC

		annotation SummarizationSetBy = Automatic

	column Inbetriebnahmejahr
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Inbetriebnahmejahr

		annotation SummarizationSetBy = Automatic

	column 'Im öffentlichen Straßenland'
		dataType: string
		summarizeBy: none
		sourceColumn: Im öffentlichen Straßenland

		annotation SummarizationSetBy = Automatic

	column Längengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Längengrad
		dataCategory: Longitude

		annotation SummarizationSetBy = Automatic

	column Breitengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Breitengrad
		dataCategory: Latitude

		annotation SummarizationSetBy = Automatic

	partition Ladestation = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=";", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars=true]),
				    Typisiert = Table.TransformColumnTypes(Kopfzeilen, {{"Ladestation-ID", type text}, {"Betreiber", type text}, {"Stadtwerke", type text}, {"Adresse", type text}, {"PLZ", type text}, {"Bezirk", type text}, {"Ladepunkte", Int64.Type}, {"Höchstleistung kW", type number}, {"Leistungsklasse", type text}, {"Schnellladen DC", type text}, {"Inbetriebnahmejahr", Int64.Type}, {"Im öffentlichen Straßenland", type text}, {"Längengrad", type number}, {"Breitengrad", type number}}, "en-US")
				in
				    Typisiert

	annotation PBI_ResultType = Table
