/// An öffentlichen Ladepunkten abgegebene Energie je Bezirk und Jahr laut Land Berlin, in kWh. 2017 bis 2019 fehlen in der Quelle.
table Ladestrom

	column Bezirk
		dataType: string
		summarizeBy: none
		sourceColumn: Bezirk

		annotation SummarizationSetBy = Automatic

	column Jahr
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Jahr

		annotation SummarizationSetBy = Automatic

	column 'Ladestrom öffentlich kWh'
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Ladestrom öffentlich kWh

		annotation SummarizationSetBy = Automatic

	partition Ladestrom = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=";", Columns=3, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars=true]),
				    Typisiert = Table.TransformColumnTypes(Kopfzeilen, {{"Bezirk", type text}, {"Jahr", Int64.Type}, {"Ladestrom öffentlich kWh", Int64.Type}}, "en-US")
				in
				    Typisiert

	annotation PBI_ResultType = Table
