/// Hilfstabelle: jede Ladestation höchstens 500 m Luftlinie vom Umriss eines eigenständigen Quartiers, mit Abstand (0 = im Quartier).
table 'Quartier Ladestation'
	isHidden

	column 'Quartier-ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Quartier-ID

		annotation SummarizationSetBy = Automatic

	column 'Ladestation-ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Ladestation-ID

		annotation SummarizationSetBy = Automatic

	column 'Abstand m'
		dataType: double
		isHidden
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: Abstand m

		annotation SummarizationSetBy = Automatic

	column 'Bis 300 m'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Bis 300 m

		annotation SummarizationSetBy = Automatic

	partition 'Quartier Ladestation' = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=";", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars=true]),
				    Typisiert = Table.TransformColumnTypes(Kopfzeilen, {{"Quartier-ID", type text}, {"Ladestation-ID", type text}, {"Abstand m", type number}, {"Bis 300 m", type text}}, "en-US")
				in
				    Typisiert

	annotation PBI_ResultType = Table
