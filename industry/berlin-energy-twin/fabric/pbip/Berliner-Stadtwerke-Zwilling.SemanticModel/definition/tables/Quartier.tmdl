/// degewo-Quartiere: drei benannte (Gropiusstadt, Marzahn, Brunnenviertel) und Cluster nach Postleitzahl. Feuchtwangerweg (12353) liegt in der Gropiusstadt: Eigenständiges Quartier = nein, für Summen immer die Measures verwenden. Die Ladepunkt-Spalten sind je Quartier gezählt; über mehrere Quartiere nicht addieren, dafür die Measures nutzen. Auch: Siedlung, Wohnquartier, Kiez.
table Quartier

	column 'Quartier-ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Quartier-ID

		annotation SummarizationSetBy = Automatic

	column Quartier
		dataType: string
		summarizeBy: none
		sourceColumn: Quartier

		annotation SummarizationSetBy = Automatic

	column Quartiersart
		dataType: string
		summarizeBy: none
		sourceColumn: Quartiersart

		annotation SummarizationSetBy = Automatic

	column Bezirk
		dataType: string
		summarizeBy: none
		sourceColumn: Bezirk

		annotation SummarizationSetBy = Automatic

	column Einwohner
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Einwohner

		annotation SummarizationSetBy = Automatic

	column 'Eigenständiges Quartier'
		dataType: string
		summarizeBy: none
		sourceColumn: Eigenständiges Quartier

		annotation SummarizationSetBy = Automatic

	column 'Teil von'
		dataType: string
		summarizeBy: none
		sourceColumn: Teil von

		annotation SummarizationSetBy = Automatic

	column Quelle
		dataType: string
		summarizeBy: none
		sourceColumn: Quelle
		dataCategory: WebUrl

		annotation SummarizationSetBy = Automatic

	column 'Ladestationen bis 300 m'
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Ladestationen bis 300 m

		annotation SummarizationSetBy = Automatic

	column 'Ladepunkte bis 300 m'
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Ladepunkte bis 300 m

		annotation SummarizationSetBy = Automatic

	column 'Stadtwerke-Ladepunkte bis 300 m'
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Stadtwerke-Ladepunkte bis 300 m

		annotation SummarizationSetBy = Automatic

	column 'Stadtwerke-Ladelücke 300 m'
		dataType: string
		summarizeBy: none
		sourceColumn: Stadtwerke-Ladelücke 300 m

		annotation SummarizationSetBy = Automatic

	column 'Ladepunkte bis 500 m'
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Ladepunkte bis 500 m

		annotation SummarizationSetBy = Automatic

	column 'Stadtwerke-Ladepunkte bis 500 m'
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Stadtwerke-Ladepunkte bis 500 m

		annotation SummarizationSetBy = Automatic

	column Längengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Längengrad
		dataCategory: Longitude

		annotation SummarizationSetBy = Automatic

	column Breitengrad
		dataType: double
		formatString: 0.000000
		summarizeBy: none
		sourceColumn: Breitengrad
		dataCategory: Latitude

		annotation SummarizationSetBy = Automatic

	partition Quartier = m
		mode: import
		source =
				let
				    Quelle = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=";", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Kopfzeilen = Table.PromoteHeaders(Quelle, [PromoteAllScalars=true]),
				    Typisiert = Table.TransformColumnTypes(Kopfzeilen, {{"Quartier-ID", type text}, {"Quartier", type text}, {"Quartiersart", type text}, {"Bezirk", type text}, {"Einwohner", Int64.Type}, {"Eigenständiges Quartier", type text}, {"Teil von", type text}, {"Quelle", type text}, {"Ladestationen bis 300 m", Int64.Type}, {"Ladepunkte bis 300 m", Int64.Type}, {"Stadtwerke-Ladepunkte bis 300 m", Int64.Type}, {"Stadtwerke-Ladelücke 300 m", type text}, {"Ladepunkte bis 500 m", Int64.Type}, {"Stadtwerke-Ladepunkte bis 500 m", Int64.Type}, {"Längengrad", type number}, {"Breitengrad", type number}}, "en-US")
				in
				    Typisiert

	annotation PBI_ResultType = Table
