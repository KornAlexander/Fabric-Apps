// Vorjahr (PY) = Ist des Vorjahres, gleiche Körnung wie der Datenwürfel.
DEFINE
    VAR _yr = YEAR ( CALCULATE ( MAX ( 'Sales Demo'[Date] ), 'Sales Demo'[Scenario] = "AC" ) )
EVALUATE
SUMMARIZECOLUMNS (
    'dim-markt'[Country],
    'dim-produkt'[Product],
    Calender[Month],
    'dim-kpi'[KPI],
    TREATAS ( { _yr - 1 }, Calender[Year] ),
    "PY", ROUND ( CALCULATE ( SUM ( 'Sales Demo'[Value] ), 'Sales Demo'[Scenario] = "AC" ), 1 )
)