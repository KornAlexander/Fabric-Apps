# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Build output
dist/
build/
*.tsbuildinfo

# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# Rayfin deployment state — contains tenant/workspace GUIDs and the publishable key.
# This repo is destined for Jumpstart / awesome-rayfin (PLAN §14 Q6), so none of it ships.
rayfin/.env
rayfin/.deployments.json
rayfin/.lockfile.json
rayfin/.temp/

# Test output
test-results/
playwright-report/
.playwright-mcp/

# Raw + intermediate geodata (large, redownloadable — see NOTICE.md for sources)
data/raw/
data/interim/
data/cache/

# Pipeline artefacts that must never be deployed or committed. buildings_lod2_footprints.json
# pairs a cadastral ID with the Copernicus damage grade, which PLAN §2.2 allows in aggregate only;
# the nodata masks are build inputs for build_flowfield.py. Both were served publicly until
# 2026-07-29 — moving them here is pointless if git then carries them instead.
data/derived/

# Rendered demo media. The narration script is tracked because it is the source; the 34 MB mp4
# and 21 MB gif are not, because they are reproducible from it and from tools/rec — and because
# this repo is headed for public packaging, where 54 MB of binary in the history is a permanent
# cost for something a release asset carries better.
media/*.mp4
media/*.gif
media/*.webm
*.laz
*.las
*.tif
*.tiff
*.gml
*.xyz
*.zip

# Generated app assets (rebuilt by tools/geodata)
public/terrain/
public/buildings/
public/drape/
*.ktx2
*.glb

# Local scratch
temp/
scratch/
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json

# Curated analytical tables (regenerated by tools/geodata/build_portfolio.py)
data/curated/

# Fabric item ids (workspace/lakehouse/model GUIDs)
tools/fabric/.fabric-ids.json
