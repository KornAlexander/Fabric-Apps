{
  "name": "flut-insights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "template": {
    "name": "flood-insights",
    "displayName": "Flood Insights",
    "description": "Flood risk and gauge levels on a 3D terrain twin, with an IBCS Power BI report.",
    "category": "digital-twins"
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "vite",
    "dev:fabric": "rayfin up --exclude-services staticHosting && vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test validation.spec.ts scene-switch.spec.ts compass.spec.ts",
    "gauges:fetch": "python tools/geodata/fetch_hvz_gauges.py",
    "lint": "eslint .",
    "test": "vitest run",
    "data:build": "python tools/geodata/pipeline.py"
  },
  "dependencies": {
    "@microsoft/rayfin-auth-provider-fabric": "^1.33.0",
    "@microsoft/rayfin-client": "^1.33.0",
    "@microsoft/rayfin-core": "^1.33.0",
    "@tailwindcss/vite": "^4.1.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.33.0",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
