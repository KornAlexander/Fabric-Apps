# Copy to .env and fill in. `.env` is git-ignored.
# Values marked (generated) are written for you by scripts/provision-environment.ps1.

# --- Secrets: obtain per environment -------------------------------------
# https://ion.cesium.com -> Access Tokens. Unlocks Google 3D Tiles + OSM Buildings.
VITE_CESIUM_ION_TOKEN=

# https://opendata.transport.nsw.gov.au -> My Account -> Applications.
# No VITE_ prefix: used only by the dev-server middleware, never sent to the browser.
TFNSW_API_KEY=

# --- Deployed app: direct Eventhouse (Kusto) access ----------------------
# Not secrets. The browser queries the Eventhouse directly with the signed-in
# user's token (MSAL). Only used when the app is not served from localhost.
VITE_KUSTO_CLUSTER=          # (generated) Eventhouse query service URI
VITE_KUSTO_DATABASE=SydneyFerriesKustoDB
VITE_ENTRA_CLIENT_ID=        # (generated) SPA app registration used for the Kusto token
VITE_ENTRA_TENANT_ID=        # (generated) target tenant GUID

# --- Local dev server: optional overrides --------------------------------
# `npm run dev` queries the Eventhouse from the Vite process using your
# `az login` identity. It reuses VITE_KUSTO_CLUSTER above, so set these two
# only if you want local dev pointed somewhere else.
# KUSTO_CLUSTER_URI=
# KUSTO_DATABASE=
