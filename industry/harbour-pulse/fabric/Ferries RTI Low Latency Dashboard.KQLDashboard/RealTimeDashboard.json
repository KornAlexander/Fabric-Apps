  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "f81b298f-f9b3-4d4e-a760-ece99db6b3b1"
      },
      "text": "SydneyFerries\n| where timestamp > ago(2m)\n| summarize max_timestamp = max(timestamp) by ferry_name\n| join kind=inner (\n    SydneyFerries\n    | project ferry_name, ferry_lat, ferry_long, ferry_destination, timestamp\n) on ferry_name\n| where timestamp == max_timestamp\n| project ferry_name, ferry_lat, ferry_long,timestamp, ferry_destination\n| order by timestamp desc\n\n",
      "id": "a22c0c69-87a4-4fed-8c1b-540d13152f4c",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "f81b298f-f9b3-4d4e-a760-ece99db6b3b1"
      },
      "text": "SydneyFerries\n| where timestamp > ago(2m)\n| summarize max_timestamp = max(timestamp) by ferry_name\n| join kind=inner (\n    SydneyFerries\n    | project ferry_name, ferry_lat, ferry_long, ferry_destination, timestamp\n) on ferry_name\n| where timestamp == max_timestamp\n| project ferry_name, ferry_lat, ferry_long,timestamp, ferry_destination, colour = 1\n\n",
      "id": "b991f44a-ffa6-438f-84d2-b78c8daf1cb4",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "f81b298f-f9b3-4d4e-a760-ece99db6b3b1"
      },
      "text": "SydneyFerries\n| count",
      "id": "f3def7b3-04bb-4e88-968e-a6ddd7cc97ce",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "f81b298f-f9b3-4d4e-a760-ece99db6b3b1"
      },
      "text": "SydneyFerries\n| where timestamp > ago(20m)\n| summarize IngestionCount = count() by bin(ingestion_time(), 20sec)\n| render columnchart  \n",
      "id": "f905088c-e5fd-4b79-aa3d-b5b6efa9c1fc",
