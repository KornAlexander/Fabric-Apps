// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table SydneyFerries (ferry_name:string, ferry_lat:real, ferry_long:real, ferry_destination:string, timestamp:datetime) 
.create-or-alter table SydneyFerries ingestion json mapping 'SydneyFerries_mapping'
```
[{"Properties":{"Path":"$['ferry_name']"},"column":"ferry_name","datatype":""},{"Properties":{"Path":"$['ferry_lat']"},"column":"ferry_lat","datatype":""},{"Properties":{"Path":"$['ferry_long']"},"column":"ferry_long","datatype":""},{"Properties":{"Path":"$['ferry_destination']"},"column":"ferry_destination","datatype":""},{"Properties":{"Path":"$['timestamp']"},"column":"timestamp","datatype":""}]
```
.create-merge table ReferenceLocation (LocationId:string, LocationName:string, Latitude:real, Longitude:real, ProximityThreshold:real) 
.create-merge table ProximityAlerts (timestamp:datetime, ferry_name:string, ferry_destination:string, LocationId:string, LocationName:string, Distance:real, FerryLatitude:real, FerryLongitude:real, LocationLatitude:real, LocationLongitude:real, Alert:string) 
.create-merge table FerryTwinTelemetry (Timestamp:datetime, VesselId:string, DeckId:string, MetricName:string, MetricValue:real, Unit:string, Attributes:dynamic, TraceId:string, SpanId:string) 
.create-or-alter table FerryTwinTelemetry ingestion json mapping 'FerryTwinTelemetryMapping'
