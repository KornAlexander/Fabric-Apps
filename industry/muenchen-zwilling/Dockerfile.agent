# Backend image for the München Zwilling agent.
#
# ⚠️ THE ODBC LAYER IS FIRST AND IT IS NOT OPTIONAL. `pyodbc` installs from a wheel with no system
# dependency at all, then fails at IMPORT because `libodbc.so` is missing and at CONNECT because
# no driver is registered. A successful `pip install` therefore tells you nothing about whether
# the container can reach Fabric SQL.
#
# ⚠️ THE DEBIAN VERSION IS DETECTED, NOT WRITTEN DOWN. `python:3.12-slim` moves between Debian
# releases when the base image is rebuilt, and a hard-coded number in that URL is a build that
# keeps working until the tag moves and then fails with a 404 nobody expects.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl gnupg ca-certificates \
 && curl -fsSL -O "https://packages.microsoft.com/config/debian/$(. /etc/os-release && echo "${VERSION_ID%%.*}")/packages-microsoft-prod.deb" \
 && dpkg -i packages-microsoft-prod.deb \
 && rm packages-microsoft-prod.deb \
 && apt-get update \
 && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc \
 && rm -rf /var/lib/apt/lists/*

# ⚠️ `curl` AND `gnupg` ARE DELIBERATELY NOT PURGED. The obvious tidy-up,
# `apt-get purge -y --auto-remove curl gnupg`, produced an image where the driver was still
# REGISTERED in odbcinst.ini while its shared library was gone, so the container started happily
# and then failed on first connect with:
#   Can't open lib '/opt/microsoft/msodbcsql18/lib64/libmsodbcsql-18.7.so.1.1' : file not found
# A few megabytes of image size is not worth a failure that only appears against a real database.

# ⚠️ WORLD-READABLE, BECAUSE THIS IMAGE DOES NOT RUN AS ROOT. The driver package installs under
# /opt/microsoft with root-only permissions on some layouts, and `dlopen` from an unprivileged
# process then fails. unixODBC reports that as **"file not found"**, naming a path that is plainly
# present, which sends you looking for a missing package instead of a mode bit.
RUN chmod -R a+rX /opt/microsoft \
 && echo '--- driver library, as installed ---' \
 && ls -la /opt/microsoft/msodbcsql18/lib64/ \
 && echo '--- odbcinst.ini ---' \
 && cat /etc/odbcinst.ini

COPY server/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# ⚠️ CHECKS THE LIBRARY ON DISK, NOT JUST THE REGISTRATION, AND THE DIFFERENCE IS THE WHOLE POINT.
# `pyodbc.drivers()` reads odbcinst.ini and nothing else, so it happily lists a driver whose `.so`
# was never installed or cannot be opened. The first version of this check did exactly that,
# passed, and shipped an image that could not open a connection.
#
# ⚠️ AND IT RUNS AS THE RUNTIME USER, because that is the question being asked. Verifying as root
# proves the file exists; it does not prove the process that will actually connect can open it.
RUN useradd --uid 1000 --create-home appuser
USER 1000
RUN python -c "import pyodbc, glob, ctypes; d=[x for x in pyodbc.drivers() if 'SQL Server' in x]; l=glob.glob('/opt/microsoft/msodbcsql18/lib64/libmsodbcsql*.so*'); print('registered:', d); print('libraries:', l); assert d, 'no SQL Server ODBC driver registered'; assert l, 'driver registered but its shared library is missing'; [ctypes.CDLL(p) for p in l]; print('dlopen ok as uid 1000')"

COPY server/ ./server/

ENV PORT=8080 \
    PYTHONUNBUFFERED=1
EXPOSE 8080

# `--app-dir server` matches how the modules import each other as top-level names, which is also
# how it runs on a laptop. Keeping the two identical means a working local run is evidence about
# the container.
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT} --app-dir server"]
